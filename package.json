		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@iarna/toml": "^2.2.5",
		"@tiptap/core": "^3.26.1",
		"@tiptap/pm": "^3.26.1",
		"@tiptap/starter-kit": "^3.26.1",
		"gray-matter": "^4.0.3"
