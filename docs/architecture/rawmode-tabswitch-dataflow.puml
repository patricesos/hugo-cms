@startuml
skinparam monochrome true
skinparam rectangle {
  BorderColor black
  FontColor black
}

rectangle "Editor.svelte\n(instance unique)" as Editor {
  rectangle "rawMode\n$props() local" as RawMode
  rectangle "$effect(content)" as EffContent #FFDDDD
  rectangle "$effect(rawMode)" as EffRawMode
  rectangle "getContent?.(() => rawMode\n  ? rawContent\n  : getMarkdown())" as GetContent #FFDDDD
  rectangle "buildEditor()\nTiptap" as Tiptap
  rectangle "CM6\nraw editor" as CM6
  rectangle "rawContent\n$state" as RawContent #FFDDDD
}

rectangle "editorStore\nswitchToTab()" as SwitchToTab {
  rectangle "_editorGetContent?.()" as CallGet
  rectangle "tab.content = savedContent" as SaveTab
  rectangle "editorContent\n.set(tab.content)" as SetEdContent
  rectangle "currentSlug.set()" as SetSlug
}

' === Data Flow Connections ===
RawMode --> GetContent : rawMode = true/false
SwitchToTab --> CallGet
CallGet --> GetContent : _editorGetContent()
GetContent --> CallGet : returns content
CallGet --> SaveTab
SwitchToTab --> SetEdContent
SetEdContent --> EffContent : triggers update
EffContent --> RawContent : binds data

note right of EffContent #FFDDDD
  <color:red><font:bold>== Bug Scenario (Raw Mode) ==</font></color>
  1. GetContent returns rawContent (fm + body)
  2. SwitchToTab saves this into tab.content
  3. SetEdContent updates content prop
  4. EffContent prepends fm AGAIN → Duplication!
end note

note right of SwitchToTab #DDFFDD
  <color:green><font:bold>== Clean Scenario (WYSIWYG) ==</font></color>
  1. GetContent returns body only
  2. tab.content gets clean body
  3. EffContent runs setContent(body)
  4. Clean state preserved
end note

legend top
  <color:red><font:bold>Bug frontmatter double</font></color>
  switchToTab depuis rawMode sauvegarde
  rawContent (fm+body) dans tab.content,
  puis le $effect(content) re-prépende
  le frontmatter → doublon.
endlegend
@enduml
