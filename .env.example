# Root of the Hugo site (contains content/, static/, config/, archetypes/)
# Required — set this to your Hugo project root
HUGO_SITE_PATH=my-hugo

# Optional overrides (derived from HUGO_SITE_PATH by default)
# HUGO_CONTENT_PATH=
# HUGO_STATIC_PATH=

# Hugo server
# These can also be set via Settings → Avancé (user settings override when env is absent)
HUGO_SERVER_PORT=1313
HUGO_BIND_ADDRESS=127.0.0.1
HUGO_STARTUP_TIMEOUT=15000
HUGO_STOP_TIMEOUT=5000

# Directories
# TRASH_DIR can also be set via Settings → Avancé (user setting used when env is absent)
TRASH_DIR=_trash
ARCHETYPES_DIR=archetypes
CONFIG_DIR=config
SHORTCODES_DIR=layouts/shortcodes
IMAGES_DIR=images

# Delays (ms)
EXTERNAL_POLL_INTERVAL=5000
AUTO_SAVE_DELAY=2000
FM_SAVE_DELAY=2000

# Content
DEFAULT_AUTHOR=patricesos
DATE_FORMAT=YYYY-MM-DD
DEFAULT_ARCHETYPE=default

# Git
GIT_ENABLED=false
GIT_REMOTE=origin
GIT_BRANCH=main

# CMS server port (default 1703 in production)
# Can also be set via Settings → Avancé (user setting used when env is absent)
PORT=1703

# UI
APP_TITLE=Hugo CMS
